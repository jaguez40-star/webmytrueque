# Copiar a .env y ajustar. NUNCA comitear .env (está en .gitignore).
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
DATABASE_URL=sqlite:///./data/trueque.db
CORS_ORIGINS=http://localhost:5173

# Credenciales OAuth de Google (proyecto "MyTrueque" en Google Cloud Console).
# El Secret solo se ve UNA vez al crear el cliente; si se pierde, se genera uno nuevo
# desde Google Auth Platform → Clientes.
GOOGLE_CLIENT_ID=<tu-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<tu-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# A dónde redirige el callback de Google tras completar el login.
FRONTEND_URL=http://localhost:5173
